PEXELS_API_KEY= # only needed if MEDIA_PROVIDER=pexels (or left unset)
MEDIA_PROVIDER=pollinations # "pexels" (stock footage) or "pollinations" (free AI-generated images animated with a Ken Burns effect)
POLLINATIONS_API_KEY= # optional, no key required for basic use; set for higher rate limits, get one at https://enter.pollinations.ai
POLLINATIONS_STYLE_PROMPT= # optional, appended to every image prompt to control the art style, e.g. "hand-drawn 2D doodle animation style, flat colors, bold black outlines"
LOG_LEVEL=trace # trace, debug, info, warn, error, fatal, silent
WHISPER_VERBOSE=true
PORT=3123
DEV=true # local development mode
DATA_DIR_PATH= # only for docker, otherwise leave empty
